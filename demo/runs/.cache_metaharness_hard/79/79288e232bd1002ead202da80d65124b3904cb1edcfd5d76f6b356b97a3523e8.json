in all_transactions:\n    transactions[tx_id] = (date, amount, status)\n\n# Filter for date range and paid status\nstart_date = datetime.strptime(\"2024-08-15\", \"%Y-%m-%d\").date()\nend_date = datetime.strptime(\"2024-10-23\", \"%Y-%m-%d\").date()\n\npaid_amounts = []\nfor tx_id, (date_str, amount_str, status) in transactions.items():\n    date = parse_date(date_str)\n    if start_date <= date <= end_date and is_paid(status):\n        amount_usd = parse_amount(amount_str)\n        paid_amounts.append(amount_usd)\n\naverage = sum(paid_amounts) / len(paid_amounts)\nprint(f\"{average:.2f}\")\n```\n\nANSWER: $2,281.01", "usage": {"calls": 1, "input_tokens": 3773, "output_tokens": 8583, "cost_usd": 0.046688, "latency_s": 52.307618856430054}, "model": "claude-haiku-4-5-20251001", "stop_reason": "end_turn"}