s = [\"%Y-%m-%d\", \"%b %d %Y\", \"%d/%m/%Y\"]\n    for fmt in formats:\n        try:\n            return datetime.strptime(date_str, fmt)\n        except ValueError:\n            continue\n    raise ValueError(f\"Could not parse: {date_str}\")\n\ndef parse_amount(amount_str):\n    \"\"\"Convert amount to USD\"\"\"\n    if \"EUR\" in amount_str:\n        eur_str = amount_str.replace(\" EUR\", \"\").replace(\".\", \"\").replace(\",\", \".\")\n        return float(eur_str) * 1.052\n    else:\n        usd_str = amount_str.replace(\"$\", \"\").replace(\",\", \"\")\n        return float(usd_str)\n\n# Build dict keeping last occurrence of each transaction ID\ntx_dict = {}\nfor tx_id, date_str, status, amount_str in transactions:\n    tx_dict[tx_id] = (date_str, status, amount_str)\n\n# Filter for date range and paid status\nstart_date = datetime(2024, 5, 31)\nend_date = datetime(2024, 7, 26)\npaid_statuses = {\"paid\", \"PAID\", \"settled\"}\n\nqualifying_amounts = []\nfor tx_id in sorted(tx_dict.keys()):\n    date_str, status, amount_str = tx_dict[tx_id]\n    date = parse_date(date_str)\n    \n    if start_date <= date <= end_date and status in paid_statuses:\n        amount_usd = parse_amount(amount_str)\n        qualifying_amounts.append(amount_usd)\n\naverage = sum(qualifying_amounts) / len(qualifying_amounts)\nprint(f\"{average:.2f}\")\n```\n\nANSWER: 2147.61", "usage": {"calls": 1, "input_tokens": 4161, "output_tokens": 10349, "cost_usd": 0.060058, "latency_s": 64.14062142372131}, "model": "claude-haiku-4-5-20251001", "stop_reason": "end_turn"}