{"text": "```python\nfrom datetime import datetime\n\ndef parse_date(date_str):\n    \"\"\"Handle YYYY-MM-DD, DD/MM/YYYY, and 'Mon DD YYYY' formats.\"\"\"\n    formats = [\"%Y-%m-%d\", \"%d/%m/%Y\", \"%b %d %Y\"]\n    for fmt in formats:\n        try:\n            return datetime.strptime(date_str.strip(), fmt).date()\n        except ValueError:\n            continue\n    return None\n\ndef convert_to_usd(amount_str, currency):\n    \"\"\"Extract numeric amount and convert to USD if needed.\"\"\"\n    EUR_RATE = 1.052\n    \n    if currency.upper() == 'EUR':\n        # European format: 1.234,56 means 1234.56\n        # Replace . with empty and , with .\n        amount_str = amount_str.replace('.', '').replace(',', '.')\n    else:\n        # USD format: remove commas (thousands separator)\n        amount_str = amount_str.replace(',', '')\n    \n    amount = float(amount_str)\n    \n    if currency.upper() == 'EUR':\n        return amount * EUR_RATE\n    return amount\n\ndef is_paid(status):\n    \"\"\"Check if transaction status means paid/settled.\"\"\"\n    status_lower = status.strip().lower()\n    return status_lower in ['paid', 'settled']\n\n# All transactions as tuples (id, date_str, amount_str, currency, status)\ntransactions = [\n    (\"T1000\", \"2024-07-11\", \"1.935,12\", \"EUR\", \"PAID\"),\n    (\"T1001\", \"Oct 01 2024\", \"281.60\", \"USD\", \"PAID\"),\n    (\"T1002\", \"2024-09-11\", \"1,546.04\", \"USD\", \"PAID\"),\n    (\"T1003\", \"2024-06-07\", \"509.22\", \"USD\", \"PAID\"),\n    (\"T1004\", \"2024-09-11\", \"97.66\", \"USD\", \"settled\"),\n    (\"T1005\", \"2024-08-11\", \"4.526,90\", \"EUR\", \"pending\"),\n    (\"T1006\", \"2024-07-13\", \"951,87\", \"EUR\", \"paid\"),\n    (\"T1007\", \"Jun 01 2024\", \"1.644,82\", \"EUR\", \"paid\"),\n    (\"T1008\", \"Sep 16 2024\", \"4,667.45\", \"USD\", \"PAID\"),\n    (\"T1009\", \"2024-09-10\", \"3,146.02\", \"USD\", \"settled\"),\n    (\"T1010\", \"Aug 15 2024\", \"1,033.04\", \"USD\", \"paid\"),\n  