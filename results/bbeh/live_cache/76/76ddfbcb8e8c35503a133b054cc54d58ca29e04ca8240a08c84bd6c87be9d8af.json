413, 35.38789),\n    (29.05665, 33.72118)\n]\n\ndef dist(p1, p2):\n    return math.sqrt((p1[0]-p2[0])**2 + (p1[1]-p2[1])**2)\n\ndef dot_product(v1, v2):\n    return v1[0]*v2[0] + v1[1]*v2[1]\n\ndef cross_product(v1, v2):\n    return v1[0]*v2[1] - v1[1]*v2[0]\n\ndef vector_between(p1, p2):\n    return (p2[0]-p1[0], p2[1]-p1[1])\n\ndef classify_shape(vertices):\n    \"\"\"Classify a polygon shape\"\"\"\n    n = len(vertices)\n    print(f\"\\nShape with {n} vertices:\")\n    for i, v in enumerate(vertices):\n        print(f\"  {i}: {v}\")\n    \n    # Remove collinear points\n    real_vertices = []\n    for i in range(n):\n        p1 = vertices[i]\n        p2 = vertices[(i+1)%n]\n        p3 = vertices[(i+2)%n]\n        \n        v1 = vector_between(p1, p2)\n        v2 = vector_between(p2, p3)\n        \n        cp = cross_product(v1, v2)\n        if abs(cp) > 1e-6:  # Not collinear\n            real_vertices.append(p2)\n    \n    print(f\"  After removing collinear points: {len(real_vertices)} vertices\")\n    \n    n = len(real_vertices)\n    \n    # Compute side lengths\n    side_lengths = []\n    for i in range(n):\n        p1 = real_vertices[i]\n        p2 = real_vertices[(i+1)%n]\n        side_lengths.append(dist(p1, p2))\n    \n    print(f\"  Side lengths: {[f'{s:.4f}' for s in side_lengths]}\")\n    \n    # Check for right angles\n    right_angles = 0\n    for i in range(n):\n        p1 = real_vertices[i-1]\n        p2 = real_vertices[i]\n        p3 = real_vertices[(i+1)%n]\n        \n        v1 = vector_between(p2, p1)\n        v2 = vector_between(p2, p3)\n        \n        dot = dot_product(v1, v2)\n        print(f\"  Angle at vertex {i}: dot={dot:.4f}\")\n        \n        if abs(dot) < 0.01:\n            right_angles += 1\n    \n    print(f\"  Right angles: {right_angles}\")\n    \n    # Check for parallel sides\n    if n >= 4:\n        slopes = []\n        for i in range(n):\n            p1 = real_vertices[i]\n            p2 = real_vertices[(i+1)%n]\n      