d(p1)\n\ndef dist(p1, p2):\n    return math.sqrt((p1[0]-p2[0])**2 + (p1[1]-p2[1])**2)\n\ndef find_closed_loops(start_vertex, graph, max_length=20):\n    \"\"\"Find all closed loops starting from a vertex using DFS\"\"\"\n    paths = []\n    \n    def dfs(v, path, visited_edges):\n        if len(path) > max_length:\n            return\n        \n        for next_v in graph[v]:\n            edge = (min(v, next_v), max(v, next_v))\n            if edge in visited_edges:\n                continue\n                \n            if next_v == start_vertex and len(path) >= 3:\n                paths.append(list(path))\n            elif next_v not in path:\n                visited_edges.add(edge)\n                dfs(next_v, path + [next_v], visited_edges)\n                visited_edges.remove(edge)\n    \n    visited_edges = set()\n    for next_v in graph[start_vertex]:\n        edge = (min(start_vertex, next_v), max(start_vertex, next_v))\n        visited_edges.add(edge)\n        dfs(next_v, [start_vertex, next_v], visited_edges)\n        visited_edges.remove(edge)\n    \n    return paths\n\n# Find all closed loops\nall_loops = []\nfound_vertices = set()\n\nfor start_v in list(graph.keys())[:30]:  # Check first 30 vertices\n    loops = find_closed_loops(start_v, graph)\n    for loop in loops:\n        loop_key = tuple(sorted(loop))\n        if loop_key not in found_vertices:\n            all_loops.append(loop)\n            found_vertices.add(loop_key)\n\nprint(f\"Found {len(all_loops)} potential closed loops\")\nfor i, loop in enumerate(all_loops[:5]):\n    print(f\"\\nLoop {i+1}: {len(loop)} vertices\")\n    for v in loop[:5]:\n        print(f\"  {v}\")\n    if len(loop) > 5:\n        print(f\"  ... ({len(loop)-5} more)\")\n\nEOF\npython3 /tmp/claude-0/-tmp-claude-0--home-user-RSI-ebd00391-ba98-5b98-9125-83abd1dce979-scratchpad-bbh-wt/ebd00391-ba98-5b98-9125-83abd1dce979/scratchpad/find_shapes.py\n</parameter>\n</invoke>\n</function_calls>\n<function_calls>\n<invoke name=\"