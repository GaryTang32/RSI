= r'M\\s*([-\\d.]+),([-\\d.]+)|L\\s*([-\\d.]+),([-\\d.]+)'\nmatches = re.findall(pattern, path_str)\n\nsegments = []\ncurrent_point = None\n\nfor m_x, m_y, l_x, l_y in matches:\n    if m_x:  # M command\n        current_point = (float(m_x), float(m_y))\n    else:  # L command\n        end_point = (float(l_x), float(l_y))\n        if current_point:\n            segments.append((current_point, end_point))\n        current_point = end_point\n\n# Build graph\nEPSILON = 0.01  # Tolerance for matching points\ngraph = defaultdict(list)\npoint_map = {}  # Maps rounded points to original\n\ndef round_point(p):\n    return (round(p[0], 2), round(p[1], 2))\n\nfor start, end in segments:\n    start_key = round_point(start)\n    end_key = round_point(end)\n    point_map[start_key] = start\n    point_map[end_key] = end\n    graph[start_key].append(end_key)\n    graph[end_key].append(start_key)\n\nprint(f\"Unique vertices: {len(point_map)}\")\n\n# Find closed polygons/cycles using DFS\ndef find_cycle(start_node, graph, excluded_edge=None):\n    \"\"\"Find a cycle starting from start_node\"\"\"\n    stack = [(start_node, [start_node], set([start_node]))]\n    \n    while stack:\n        node, path, visited = stack.pop()\n        \n        for neighbor in graph[node]:\n            # Avoid immediate backtracking\n            if neighbor == path[-2] if len(path) > 1 else False:\n                continue\n            \n            if neighbor == start_node and len(path) >= 3:\n                return path  # Found a cycle\n            elif neighbor not in visited:\n                stack.append((neighbor, path + [neighbor], visited | {neighbor}))\n    \n    return None\n\n# Find all cycles\nfound_cycles = []\nunprocessed = set(graph.keys())\n\nwhile unprocessed:\n    start = unprocessed.pop()\n    cycle = find_cycle(start, graph)\n    \n    if cycle and len(cycle) >= 3:\n        found_cycles.append(cycle)\n        # Remove cycle nodes from unprocessed\n        for node in cycle:\n       