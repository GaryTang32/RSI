82,39.7348 M 0.0,1.61459 L 0.0,1.97046 M 0.0,4.55534 L 0.0,8.95663 M 31.0395,36.00435 L 30.50413,35.38789 M 27.14765,35.60872 L 29.41315,36.82127 M -7.5495,1.97046 L -7.5495,0.0 M 33.77773,39.1573 L 31.0395,36.00435 M -27.81802,40.29299 L -27.89074,39.46178 M 0.0,0.55035 L 0.0,1.12316 M -25.90423,41.76152 L -26.44109,42.40132 M -26.13864,51.37523 L -26.66695,51.42144 M -27.76748,40.87061 L -28.14351,41.31875 M 29.05665,33.72118 L 20.66361,24.05697 M 0.0,8.95663 L -1.23976,8.95663 M -28.79144,42.62222 L -28.7133,42.68779 M -27.76748,40.87061 L -27.80134,40.4836 M 6.10991,-0.92863 L 6.6699,-1.01374 M -25.1922,45.64235 L -24.86339,45.91826 M 6.6699,-1.01374 L 7.75693,-1.17896 M -22.77494,41.14363 L -32.26699,46.23293 M -27.76748,40.87061 L -25.31614,42.92753 M 0.0,1.12316 L 0.0,1.61459 M -24.7472,47.32115 L -24.499,47.52942 M 0.0,1.97046 L 0.0,4.55534 M -29.05306,42.4027 L -28.79144,42.62222 M 10.14295,18.42605 L 6.55706,16.5068 M -25.09958,47.02547 L -24.7472,47.32115 M -28.20367,43.11542 L -25.1922,45.64235\"\"\"\n\n# Parse edges\nedges = []\ntokens = path_data.split()\ni = 0\nwhile i < len(tokens):\n    if tokens[i] == 'M':\n        start_x, start_y = float(tokens[i+1].split(',')[0]), float(tokens[i+1].split(',')[1])\n        i += 2\n    elif tokens[i] == 'L':\n        end_x, end_y = float(tokens[i+1].split(',')[0]), float(tokens[i+1].split(',')[1])\n        edges.append(((start_x, start_y), (end_x, end_y)))\n        start_x, start_y = end_x, end_y\n        i += 2\n    else:\n        i += 1\n\ndef dist(p1, p2):\n    return math.sqrt((p1[0]-p2[0])**2 + (p1[1]-p2[1])**2)\n\ndef is_collinear(p1, p2, p3, tolerance=0.1):\n    \"\"\"Check if three points are approximately collinear\"\"\"\n    if p1 == p2 or p2 == p3:\n        return True\n    cross = abs((p2[0]-p1[0])*(p3[1]-p1[1]) - (p2[1]-p1[1])*(p3[0]-p1[0]))\n    d = dist(p1, p3)\n    return cross / max(d, 0.01) < tolerance\n\ndef angle_between(v1, v2):\n    \"\"\"Calculate angle between two vectors in degrees\"\"\"\n