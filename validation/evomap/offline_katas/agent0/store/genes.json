dates", "dates", "calendar", "duration"], "mode": "none", "outcome": "success", "reason_class": "ok", "retryable": true}, {"at": "2026-05-29T03:26:40Z", "learning_signals": ["task:dates", "dates", "calendar", "duration"], "mode": "none", "outcome": "success", "reason_class": "ok", "retryable": true}], "provenance": {"author": "agent0", "cycle": 1, "kind": "evolved"}, "schema_version": "1.14.0", "signals_match": ["dates", "calendar"], "strategy": ["Parse with date.fromisoformat or datetime.strptime and an explicit format such as '%m/%d/%Y'.", "Do date arithmetic with datetime.date and timedelta, never with hand-rolled day counts.", "Gregorian leap year: divisible by 4 and (not by 100, or by 400).", "Index weekday names with date.weekday() where Monday == 0."], "summary": "Date bugs: parse with explicit formats and do arithmetic with datetime, never by hand.", "type": "Gene", "validation": ["python smoke_test.py"]}, {"asset_id": "sha256:fe55182bb82b98aa83958d35973d0d2d77da0858ac31a5b5553259ca5b8262b8", "avoid": ["lst[-n:] when n can be 0 (it returns the whole list).", "Floor division when a partial group still counts."], "category": "repair", "constraints": {"forbidden_paths": [".git", "node_modules"], "max_files": 12}, "epigenetic_marks": [{"boost": 0.2, "context": "sim/py3.11", "created_at": "2026-05-28T23:26:40Z", "reason": "success_in_environment", "t": 1780010800.0}], "id": "gene_inclusive_boundaries", "learning_history": [{"at": "2026-05-28T23:26:40Z", "learning_signals": ["task:boundaries", "boundaries", "ranges", "counting"], "mode": "none", "outcome": "success", "reason_class": "ok", "retryable": true}, {"at": "2026-05-29T02:26:40Z", "learning_signals": ["task:boundaries", "boundaries", "ranges", "counting"], "mode": "none", "outcome": "success", "reason_class": "ok", "retryable": true}, {"at": "2026-05-29T08:26:40Z", "learning_signals": ["task:boundaries", "boundaries", "ranges", "counting"], "mode": "none", "outcome": "success", "reason_class": "ok", "retry